generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth ───────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  emailVerified    DateTime?
  password         String?
  name             String?
  image            String?
  username         String?   @unique
  displayName      String?
  bio              String?
  isPremium        Boolean   @default(false)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Streak de connexion — mis à jour à chaque connexion (voir auth.ts)
  lastLoginAt   DateTime?
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  shelves          Shelf[]
  userBooks        UserBook[]
  userAchievements UserAchievement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Personnalisation du profil ─────────────────────────────────────────────

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  backgroundType  BackgroundType @default(COLOR)
  backgroundValue String         @default("#0f0f0f")
  accentColor     String         @default("#d97706")
  fontFamily      String         @default("inter")
  layoutType      LayoutType     @default(GRID)
  effectType      EffectType?
  shelfColor      String         @default("#7a4518")

  socialLinks    Json?

  seoTitle       String?
  seoDescription String?
  profileViews   Int            @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BackgroundType {
  COLOR
  GRADIENT
  IMAGE
}

enum LayoutType {
  GRID
  SHELF
  MOSAIC
  LIBRARY
}

enum EffectType {
  PARTICLES
  AMBIENT_GLOW
  NOISE
}

// ─── Livres (cache API) ──────────────────────────────────────────────────────

model Book {
  id            String   @id @default(cuid())
  openLibraryId String?  @unique
  googleBooksId String?  @unique
  isbn          String?
  title         String
  authors       String[]
  coverUrl      String?
  publishYear   Int?
  type          BookType @default(NOVEL)
  createdAt     DateTime @default(now())

  userBooks UserBook[]
}

enum BookType {
  NOVEL
  MANGA
  COMIC
}

// ─── Relation User <-> Book ──────────────────────────────────────────────────

model UserBook {
  id         String     @id @default(cuid())
  userId     String
  bookId     String
  shelfId    String?
  status     ReadStatus @default(TO_READ)
  rating     Int?
  isFavorite Boolean    @default(false)
  order      Int        @default(0)
  addedAt    DateTime   @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book   @relation(fields: [bookId], references: [id])
  shelf Shelf? @relation(fields: [shelfId], references: [id])

  @@unique([userId, bookId])
}

enum ReadStatus {
  READING
  READ
  TO_READ
  ABANDONED
}

// ─── Succès ──────────────────────────────────────────────────────────────────
// Définitions statiques dans lib/achievements.ts ; cette table ne garde que
// les déblocages (id de la définition + date), pas la définition elle-même.

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  // Renseigné quand l'utilisateur a vu le succès (visite de /dashboard/achievements) —
  // pilote le badge de notification, séparément du toast affiché une seule fois au déblocage
  seenAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ─── Rayons personnalisés ────────────────────────────────────────────────────

model Shelf {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBooks UserBook[]
}
